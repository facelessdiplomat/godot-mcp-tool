extends RefCounted

const GodotMcpAddonInfo := preload("../../addon_info.gd")
const GodotMcpCommandRouter := preload("../../commands/command_router.gd")
const GodotMcpGameBoundsCommand := preload("game_bounds_command.gd")
const GodotMcpGameEvalCommand := preload("game_eval_command.gd")
const GodotMcpGameInputCommand := preload("game_input_command.gd")
const GodotMcpGamePauseCommand := preload("game_pause_command.gd")
const GodotMcpGamePerformanceCommand := preload("game_performance_command.gd")
const GodotMcpGamePropertiesGetCommand := preload("game_properties_get_command.gd")
const GodotMcpGamePropertiesSetCommand := preload("game_properties_set_command.gd")
const GodotMcpGameScene := preload("game_scene.gd")
const GodotMcpGameScreenshotCommand := preload("game_screenshot_command.gd")
const GodotMcpGameStepCommand := preload("game_step_command.gd")
const GodotMcpGameTime := preload("../game_time.gd")
const GodotMcpGameTreeCommand := preload("game_tree_command.gd")
const GodotMcpGameWaitCommand := preload("game_wait_command.gd")
const GodotMcpPropertyEditor := preload("../../scene/property_editor.gd")
const GodotMcpVariantCodec := preload("../../codec/variant_codec.gd")


static func build_router(scene_root_provider: Callable, time: GodotMcpGameTime) -> GodotMcpCommandRouter:
	var scene := GodotMcpGameScene.new(scene_root_provider)
	var codec := GodotMcpVariantCodec.new()
	var properties := GodotMcpPropertyEditor.new(codec)
	var screenshot := GodotMcpGameScreenshotCommand.new(scene, ProjectSettings.globalize_path("res://").path_join(GodotMcpAddonInfo.CAPTURES_RELATIVE_PATH))
	var properties_reader := GodotMcpGamePropertiesGetCommand.new(scene, properties, codec)
	var router := GodotMcpCommandRouter.new()
	router.register("tree", GodotMcpGameTreeCommand.new(scene))
	router.register("properties.get", properties_reader)
	router.register("properties.set", GodotMcpGamePropertiesSetCommand.new(scene, properties))
	router.register("wait", GodotMcpGameWaitCommand.new(scene, codec, time))
	router.register("input", GodotMcpGameInputCommand.new(screenshot, time, properties_reader))
	router.register("bounds", GodotMcpGameBoundsCommand.new(scene, codec))
	router.register("screenshot", screenshot)
	router.register("pause", GodotMcpGamePauseCommand.new(time))
	router.register("step", GodotMcpGameStepCommand.new(time))
	router.register("performance", GodotMcpGamePerformanceCommand.new(scene))
	router.register("eval", GodotMcpGameEvalCommand.new(scene, codec))
	return router
