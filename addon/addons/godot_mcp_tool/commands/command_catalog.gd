extends RefCounted

const AddonInfo := preload("../addon_info.gd")
const AssetImportSettingsGetCommand := preload("asset/asset_import_settings_get_command.gd")
const AssetImportSettingsSetCommand := preload("asset/asset_import_settings_set_command.gd")
const AutoloadAddCommand := preload("project/autoload_add_command.gd")
const AutoloadRegistry := preload("../editor/autoload_registry.gd")
const AutoloadRemoveCommand := preload("project/autoload_remove_command.gd")
const CommandRouter := preload("command_router.gd")
const EditingContext := preload("../scene/editing_context.gd")
const EditorFileSystemAccess := preload("../editor/editor_file_system_access.gd")
const EditorRescanCommand := preload("editor/editor_rescan_command.gd")
const EditorRunScriptCommand := preload("editor/editor_run_script_command.gd")
const EditorScreenshotCommand := preload("editor/editor_screenshot_command.gd")
const EditorScriptEditorAccess := preload("../editor/editor_script_editor_access.gd")
const EditorSelectCommand := preload("editor/editor_select_command.gd")
const EditorViewportAccess := preload("../editor/editor_viewport_access.gd")
const GameGetOutputCommand := preload("game/game_get_output_command.gd")
const GameRequestCommand := preload("game/game_request_command.gd")
const GameRunCommand := preload("game/game_run_command.gd")
const GameStopCommand := preload("game/game_stop_command.gd")
const InputMapGetCommand := preload("input/input_map_get_command.gd")
const InputMapSetCommand := preload("input/input_map_set_command.gd")
const NodeAddCommand := preload("node/node_add_command.gd")
const NodeCallMethodCommand := preload("node/node_call_method_command.gd")
const NodeDeleteCommand := preload("node/node_delete_command.gd")
const NodeDuplicateCommand := preload("node/node_duplicate_command.gd")
const NodeFindCommand := preload("node/node_find_command.gd")
const NodeGetBoundsCommand := preload("node/node_get_bounds_command.gd")
const NodeGetPropertiesCommand := preload("node/node_get_properties_command.gd")
const NodeReparentCommand := preload("node/node_reparent_command.gd")
const NodeSetGroupsCommand := preload("node/node_set_groups_command.gd")
const NodeSetPropertiesCommand := preload("node/node_set_properties_command.gd")
const PingCommand := preload("ping_command.gd")
const ProjectInfoCommand := preload("project/project_info_command.gd")
const ProjectSettingsGetCommand := preload("project/project_settings_get_command.gd")
const ProjectSettingsSetCommand := preload("project/project_settings_set_command.gd")
const ResourceCreateCommand := preload("resource/resource_create_command.gd")
const ResourceGetCommand := preload("resource/resource_get_command.gd")
const ResourceSetPropertiesCommand := preload("resource/resource_set_properties_command.gd")
const RuntimeContext := preload("../runtime/runtime_context.gd")
const SceneBatchEditCommand := preload("scene/scene_batch_edit_command.gd")
const SceneCloseCommand := preload("scene/scene_close_command.gd")
const SceneCreateCommand := preload("scene/scene_create_command.gd")
const SceneGetTreeCommand := preload("scene/scene_get_tree_command.gd")
const SceneOpenCommand := preload("scene/scene_open_command.gd")
const SceneSaveCommand := preload("scene/scene_save_command.gd")
const SignalConnectCommand := preload("signal/signal_connect_command.gd")
const SignalDisconnectCommand := preload("signal/signal_disconnect_command.gd")
const SignalListCommand := preload("signal/signal_list_command.gd")
const UnsafeCommand := preload("unsafe_command.gd")

const INSPECTION_TIMEOUT_MSEC := 10_000
const WAIT_TIMEOUT_MSEC := 65_000
const INPUT_TIMEOUT_MSEC := 300_000
const SCREENSHOT_TIMEOUT_MSEC := 30_000


static func build_router(context: EditingContext, runtime: RuntimeContext, read_indentation: Callable, save_project_settings: Callable, autoloads: AutoloadRegistry, is_unsafe_allowed: Callable) -> CommandRouter:
	var captures := ProjectSettings.globalize_path("res://").path_join(AddonInfo.CAPTURES_RELATIVE_PATH)
	var file_system := EditorFileSystemAccess.new()
	var router := CommandRouter.new()
	router.register("ping", PingCommand.new())
	router.register("project.info", ProjectInfoCommand.new(read_indentation))
	router.register("project.settings_get", ProjectSettingsGetCommand.new(context.codec))
	router.register("project.settings_set", ProjectSettingsSetCommand.new(context.codec, save_project_settings))
	router.register("autoload.add", AutoloadAddCommand.new(autoloads, save_project_settings))
	router.register("autoload.remove", AutoloadRemoveCommand.new(autoloads, save_project_settings))
	router.register("editor.rescan", EditorRescanCommand.new(file_system, EditorScriptEditorAccess.new()))
	router.register("editor.screenshot", EditorScreenshotCommand.new(context, EditorViewportAccess.new(), captures))
	router.register("editor.select", EditorSelectCommand.new(context))
	router.register("asset.import_settings_get", AssetImportSettingsGetCommand.new(context.codec))
	router.register("asset.import_settings_set", AssetImportSettingsSetCommand.new(context.codec, file_system))
	router.register("input_map.get", InputMapGetCommand.new())
	router.register("input_map.set", InputMapSetCommand.new(save_project_settings))
	router.register("scene.create", SceneCreateCommand.new(context))
	router.register("scene.open", SceneOpenCommand.new(context))
	router.register("scene.save", SceneSaveCommand.new(context))
	router.register("scene.close", SceneCloseCommand.new(context))
	router.register("scene.get_tree", SceneGetTreeCommand.new(context))
	router.register("scene.batch_edit", SceneBatchEditCommand.new(context))
	router.register("node.add", NodeAddCommand.new(context))
	router.register("node.delete", NodeDeleteCommand.new(context))
	router.register("node.duplicate", NodeDuplicateCommand.new(context))
	router.register("node.reparent", NodeReparentCommand.new(context))
	router.register("node.find", NodeFindCommand.new(context))
	router.register("node.get_properties", NodeGetPropertiesCommand.new(context))
	router.register("node.get_bounds", NodeGetBoundsCommand.new(context, GameRequestCommand.new(runtime, "bounds", INSPECTION_TIMEOUT_MSEC)))
	router.register("node.set_properties", NodeSetPropertiesCommand.new(context))
	router.register("node.set_groups", NodeSetGroupsCommand.new(context))
	router.register("signal.list", SignalListCommand.new(context))
	router.register("signal.connect", SignalConnectCommand.new(context))
	router.register("signal.disconnect", SignalDisconnectCommand.new(context))
	router.register("resource.create", ResourceCreateCommand.new(context))
	router.register("resource.get", ResourceGetCommand.new(context))
	router.register("resource.set_properties", ResourceSetPropertiesCommand.new(context))
	router.register("game.run", GameRunCommand.new(context, runtime))
	router.register("game.stop", GameStopCommand.new(runtime))
	router.register("game.get_output", GameGetOutputCommand.new(runtime))
	router.register("game.get_tree", GameRequestCommand.new(runtime, "tree", INSPECTION_TIMEOUT_MSEC))
	router.register("game.get_properties", GameRequestCommand.new(runtime, "properties.get", INSPECTION_TIMEOUT_MSEC))
	router.register("game.set_properties", GameRequestCommand.new(runtime, "properties.set", INSPECTION_TIMEOUT_MSEC))
	router.register("game.wait", GameRequestCommand.new(runtime, "wait", WAIT_TIMEOUT_MSEC))
	router.register("game.input", GameRequestCommand.new(runtime, "input", INPUT_TIMEOUT_MSEC))
	router.register("game.screenshot", GameRequestCommand.new(runtime, "screenshot", SCREENSHOT_TIMEOUT_MSEC))
	router.register("game.pause", GameRequestCommand.new(runtime, "pause", INSPECTION_TIMEOUT_MSEC))
	router.register("game.step", GameRequestCommand.new(runtime, "step", WAIT_TIMEOUT_MSEC))
	router.register("game.performance", GameRequestCommand.new(runtime, "performance", WAIT_TIMEOUT_MSEC))
	router.register("game.eval", UnsafeCommand.new(GameRequestCommand.new(runtime, "eval", INSPECTION_TIMEOUT_MSEC), is_unsafe_allowed))
	router.register("editor.run_script", UnsafeCommand.new(EditorRunScriptCommand.new(context), is_unsafe_allowed))
	router.register("node.call_method", UnsafeCommand.new(NodeCallMethodCommand.new(context), is_unsafe_allowed))
	return router
