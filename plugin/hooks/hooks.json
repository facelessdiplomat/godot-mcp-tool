{
  "description": "Checks every GDScript file and shader that Claude writes or edits, with the language server of the Godot editor or with godot --check-only for scripts and with Godot's shader compiler for shaders, and shows Claude its errors. Keeps Claude from editing an existing scene or resource as text while the Godot editor has the project open, and names the tools that change it through the editor.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y godot-mcp-tool@0.3.0 check-scene-edit",
            "if": "Write(*.tscn)",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "npx -y godot-mcp-tool@0.3.0 check-scene-edit",
            "if": "Write(*.tres)",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y godot-mcp-tool@0.3.0 check-scene-edit",
            "if": "Edit(*.tscn)",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "npx -y godot-mcp-tool@0.3.0 check-scene-edit",
            "if": "Edit(*.tres)",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y godot-mcp-tool@0.3.0 check-edited-script",
            "if": "Write(*.gd)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "npx -y godot-mcp-tool@0.3.0 check-edited-script",
            "if": "Write(*.gdshader)",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y godot-mcp-tool@0.3.0 check-edited-script",
            "if": "Edit(*.gd)",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "npx -y godot-mcp-tool@0.3.0 check-edited-script",
            "if": "Edit(*.gdshader)",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
