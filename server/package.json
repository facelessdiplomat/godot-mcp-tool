{
  "name": "godot-mcp-tool",
  "version": "0.1.0",
  "description": "MCP server that connects Claude Code to the Godot editor",
  "license": "MIT",
  "type": "module",
  "bin": {
    "godot-mcp-tool": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "addon"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node tools/bundle-addon.js",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && node tools/check-gdscript-comments.js ../addon ../test-project/tests test/integration/fixtures",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "docs:tools": "vitest run test/reference/toolReferenceFile.test.ts --update",
    "eval": "vitest run --config vitest.evals.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
